# Copy to .env and edit. Every value shown is the default.

# ── Embeddings ───────────────────────────────────────────────
ESAM_EMBED_BACKEND=local                 # local | openai
ESAM_EMBED_MODEL_ID=BAAI/bge-base-en-v1.5
ESAM_EMBED_MODEL_DIR=models/bge-base-en-v1.5

# Only for ESAM_EMBED_BACKEND=openai (an OpenAI-compatible /v1/embeddings endpoint)
# ESAM_OPENAI_BASE_URL=https://gateway.example/v1
# ESAM_OPENAI_API_KEY=
# ESAM_OPENAI_EMBED_MODEL=

# ── Vector store ─────────────────────────────────────────────
ESAM_VECTOR_BACKEND=pgvector
ESAM_COLLECTION=esam_documents
# Default = local docker-compose database. On the pilot: VM-1 host, port 5432.
ESAM_PG_DSN=postgresql://esam_user:esam_local_only@127.0.0.1:5433/esam_pilot

# Used by docker-compose.yml (must match the DSN above)
ESAM_PG_USER=esam_user
ESAM_PG_PASSWORD=esam_local_only
ESAM_PG_DB=esam_pilot

# ── Chunking (characters) ────────────────────────────────────
ESAM_CHUNK_SIZE=600
ESAM_CHUNK_OVERLAP=80
